# Copy this file to .env and fill in your values. Never commit .env.

# --- Who is who ---------------------------------------------------------
OWNER_NAME=Your Name
ASSISTANT_NAME=Aria
# Used only for Hindi grammar (verb endings). Match it to the voices below.
ASSISTANT_GENDER=female
# Optional: your own opening line. Leave empty to use the default, which
# always says it is an AI assistant. If you set one, keep that disclosure.
GREETING=
# Facts the assistant may share (copy owner_info.example.txt -> owner_info.txt)
OWNER_INFO_FILE=owner_info.txt

# --- LLM (any OpenAI-compatible endpoint) -------------------------------
# Example: Groq (account + API key required; check their current free-tier terms)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
# Other examples:
#   OpenAI (paid):  LLM_BASE_URL=https://api.openai.com/v1
#   Gemini:         LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama (local): LLM_BASE_URL=http://localhost:11434/v1  (LLM_API_KEY may stay empty)
# Model names change often - check your provider's current model list.
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=150
LLM_TIMEOUT_SECONDS=20
MAX_HISTORY_TURNS=12

# --- Speech-to-text (local faster-whisper) ------------------------------
# tiny | base | small | medium | large-v3   (bigger = more accurate, slower, bigger download)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# auto = choose between Hindi and English per utterance; or force hi / en
WHISPER_LANGUAGE=auto

# --- Text-to-speech (edge-tts, online) ----------------------------------
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_RATE=+0%
# If edge-tts fails (e.g. offline), fall back to Windows built-in voices
TTS_FALLBACK_OFFLINE=true

# --- Audio devices (leave empty for system defaults) --------------------
# Run `python -m receptionist --list-devices`, then use an index or part of a name
INPUT_DEVICE=
OUTPUT_DEVICE=

# --- End-of-speech detection (tune with --test-mic) ---------------------
# 0 = auto-calibrate from background noise at startup
VAD_THRESHOLD=0
VAD_MIN_RMS=200
VAD_NOISE_MULT=3.5
# How long you must be silent before the assistant treats your turn as finished
SILENCE_END_MS=900
MIN_SPEECH_MS=300
MAX_UTTERANCE_SECONDS=30

# --- Interruptions ------------------------------------------------------
# Key interruption (S / Space) always works. Voice barge-in is OFF by default
# because speakers feed the assistant's own voice back into the mic.
# Turn on only with headphones.
BARGE_IN=false
